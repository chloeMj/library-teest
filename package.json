{
  "name": "library-test",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/library-test.umd.js",
  "module": "./dist/library-test.js",
  "exports": {
    ".": {
      "import": "./dist/library-test.js",
      "require": "./dist/library-test.umd.js"
    },
    "./dist/library-test.css": "./dist/library-test.css",
    "./dist/palette.css": "./dist/palette.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build && npm run build:palette && npm run build:tokens",
    "preview": "vite preview",
    "build:palette": "sass src/styles/palette.scss dist/palette.css --no-source-map --style=compressed",
    "build:tokens": "node scripts/export-figma-tokens.mjs"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.8"
  }
}
