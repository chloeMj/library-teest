{
  "name": "forma-ui-framework",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./dist/forma-ui-framework.umd.cjs",
  "module": "./dist/forma-ui-framework.js",
  "exports": {
    ".": {
      "types": "./dist/forma-ui-framework.d.ts",
      "import": "./dist/forma-ui-framework.js",
      "require": "./dist/forma-ui-framework.umd.cjs"
    },
    "./dist/forma-ui-framework.css": "./dist/forma-ui-framework.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run check:contrast && vue-tsc -b && vite build && npm run build:tokens",
    "preview": "vite preview",
    "build:tokens": "node scripts/export-figma-tokens.mjs",
    "type-check": "vue-tsc -b --force",
    "test": "vitest",
    "test:run": "vitest run",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "sass-embedded": "^1.100.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.8"
  },
  "types": "./dist/forma-ui-framework.d.ts"
}
